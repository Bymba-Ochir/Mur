# LOCAL DEVELOPMENT ONLY. npm run db:start replaces keys with local stack keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-not-started
SUPABASE_SERVICE_ROLE_KEY=local-not-started
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local secrets are generated by npm run db:prepare; never use production values.
NOTIFY_WEBHOOK_SECRET=
CRON_SECRET=
GROQ_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional local integrations. Never copy a production database URL/key here.
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_SECRET=

# Optional telemetry. Empty DSNs disable local reporting to the shared project.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_ENVIRONMENT=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
