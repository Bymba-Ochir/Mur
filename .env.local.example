# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://mur-chi.vercel.app

# Push notifications — generate a fresh pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Server-only secrets — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
NOTIFY_WEBHOOK_SECRET=
CRON_SECRET=

# Optional Sentry monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional QPay donations
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_SECRET=

# Optional database backup script
DATABASE_URL=
BACKUP_DIR=
BACKUP_KEEP=7
BACKUP_DEST=
