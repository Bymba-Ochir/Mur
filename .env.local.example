# Supabase Dashboard > Project Settings > API
# https://supabase.com/dashboard

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Таны Vercel/өөрийн домэйн — sitemap.xml, robots.txt, OG зурган линкүүдэд ашиглагдана
NEXT_PUBLIC_SITE_URL=https://mur-chi.vercel.app

# Хуучин HUGGINGFACE_API_TOKEN шаардлагагүй болсон — CLIP загвар одоо
# шууд browser дотор ажилладаг (@huggingface/transformers), серверийн
# токен, эрх огт хэрэггүй.

# Push мэдэгдэл (Nearby Alert) — VAPID түлхүүрийн хос
# (аль хэдийн үүсгэгдсэн жишээ доор, эсвэл: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BDhjHrMRMEJ4Yt5g0Ro_-jLBhhucUHCTYBw-WlJ43fvcU-t5tpqYqr-IorKb0p00iSS7VtvKn9BEEuREneIgaGA
VAPID_PRIVATE_KEY=7Ggq3fNzcP8W5tAulgyTjJwQdGtnBrDWl314DlKkcqg

# Supabase Dashboard > Project Settings > API Keys > "secret key" (sb_secret_...)
# АНХААР: маш өндөр эрхтэй түлхүүр — зөвхөн серверт, NEXT_PUBLIC_ угтваргүй
SUPABASE_SERVICE_ROLE_KEY=

# /api/notify route-ийг зөвхөн Supabase Webhook дуудаж болохоор хамгаалах нууц үг
NOTIFY_WEBHOOK_SECRET=

# Вакцины сануулга (Vercel Cron Job)-ийг хамгаалах нууц үг
# Vercel Dashboard дээр л тохируулах ёстой, Vercel автоматаар Authorization
# header-т нэмдэг тул та өөрөө URL руу дуудах шаардлагагүй
CRON_SECRET=
