# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://mur-chi.vercel.app

# Push notifications — generate a fresh pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Server-only secrets — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
NOTIFY_WEBHOOK_SECRET=
CRON_SECRET=

# Sentry public ingestion DSN (not an API token)
NEXT_PUBLIC_SENTRY_DSN=https://231681d6bf1dfc36c7a5c8481d078437@o4511857896849408.ingest.de.sentry.io/4512350101700690
# Optional override; remove this line to use the default, empty disables server tracking.
# SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_RELEASE=
SENTRY_ORG=
SENTRY_PROJECT=
# Build/source maps only; never expose this token to the browser.
SENTRY_AUTH_TOKEN=

# Optional QPay donations
