{
  "name": "mur-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "db:prepare": "node scripts/local-db.mjs prepare",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status",
    "db:reset": "node scripts/local-db.mjs reset",
    "db:migrate": "node scripts/local-db.mjs migrate",
    "db:new": "node scripts/local-db.mjs new",
    "db:diff": "node scripts/local-db.mjs diff",
    "db:check": "node scripts/check-migrations.mjs",
    "db:test": "node scripts/local-db.mjs test",
    "lint": "eslint .",
    "audit:security": "npm audit --audit-level=moderate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@sentry/nextjs": "^10.78.0",
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "next": "^16.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^25.0.1",
    "supabase": "2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "$sharp"
    },
    "@sentry/bundler-plugins": {
      "glob": "14.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    }
  }
}
